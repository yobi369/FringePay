FRINGEPAY_ENVIRONMENT=development
FRINGEPAY_API_PREFIX=/v1
FRINGEPAY_DATABASE_URL=sqlite+aiosqlite:///./fringepay.db
# Optional sandbox callback secret; never use this example file for production secrets.
# FRINGEPAY_SANDBOX_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Provider selection: sandbox is the only default. Daraja is sandbox-only in this release.
FRINGEPAY_DEFAULT_PROVIDER=sandbox
FRINGEPAY_DARAJA_ENVIRONMENT=sandbox
# Populate these from a Daraja sandbox app; never commit real credentials.
# FRINGEPAY_DARAJA_CONSUMER_KEY=
# FRINGEPAY_DARAJA_CONSUMER_SECRET=
# FRINGEPAY_DARAJA_SHORTCODE=174379
# FRINGEPAY_DARAJA_PASSKEY=
# FRINGEPAY_DARAJA_CALLBACK_URL=https://your-public-host/v1/webhooks/daraja
# FRINGEPAY_DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
